<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>彩色文本生成器</AssemblyName>
    <RootNamespace>RichTextGen</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 程序图标（与安装器共用同一份，由 installer\gen_icon.ps1 生成） -->
    <ApplicationIcon>..\installer\app.ico</ApplicationIcon>

    <!-- 固定 x86：进程架构必须与 WebView2Loader.dll（x86）一致，
         否则 AnyCPU 在 64 位系统跑 x64、加载 x86 loader 会 BadImageFormat 崩溃。
         x86 exe 在所有 Windows（32/64 位）都能运行。 -->
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>

    <!-- exe 属性 -->
    <Version>5.8.0.2</Version>
    <AssemblyVersion>5.8.0.2</AssemblyVersion>
    <FileVersion>5.8.0.2</FileVersion>
    <Product>Rich text &amp; multifunctional tool</Product>
    <AssemblyTitle>多功能性的一种工具</AssemblyTitle>
    <Description>多功能性的一种工具</Description>
    <FileDescription>多功能性的一种工具</FileDescription>
    <Copyright>2026-2027 All rights reserved - Reverse engineering strictly prohibited 3576220975@qq.com</Copyright>
    <Company>3576220975@qq.com</Company>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- HTML 宿主 + 全局热键 -->
    <Compile Include="src\*.cs" />
    <!-- 界面资源 -->
    <EmbeddedResource Include="ui\index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

</Project>
